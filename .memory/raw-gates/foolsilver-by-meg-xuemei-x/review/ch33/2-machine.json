    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "“You belong to all of us, Max. And we belong to you.” My heart stuttered so hard I was afraid it would give out entirely",
          "ok": true,
          "pos": 5307
        }
