    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "Night, night, witch bitch. We’ll see you in the morning, assuming you survive, of course",
          "ok": true,
          "pos": 4587
        }
      ],
      "words": 15
    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "She’d even managed to make friends with a rat",
          "ok": true,
          "pos": 7326
        }
      ],
      "words": 9
    },
    {
      "block": "原句6",
      "no": 6,
      "segments": [
        {
          "text": "Give him back! You have no right to touch him",
          "ok": true,
          "pos": 8382
        }
      ],
      "words": 10
    },
    {
      "block": "原句7",
      "no": 7,
      "segments": [
        {
          "text": "If they do not, we will kill you and dump your body in the river for the beasts",
          "ok": true,
          "pos": 9627
        }
      ],
      "words": 18
    },
    {
      "block": "原句8",
      "no": 8,
      "segments": [
        {
          "text": "We are sending his body back to Mindanforth",
          "ok": true,
          "pos": 9472
        }
      ],
      "words": 8
    },
    {
      "block": "原句9",
      "no": 9,
      "segments": [
        {
