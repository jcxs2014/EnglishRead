    },
    {
      "block": "原句10",
      "no": 10,
      "segments": [
        {
          "text": "No. That's unfair. Cathie's been a good friend to me. It's not her fault I'm a walking, talking trauma wound. And she is",
          "ok": true,
          "pos": 17714
        }
