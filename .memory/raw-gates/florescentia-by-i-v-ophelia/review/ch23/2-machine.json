      "no": 8,
      "segments": [
        {
          "text": "“Mr. and Mrs. Fairfax don’t have any nephews.”",
          "ok": true,
          "pos": 11344
        },
        {
          "text": "“You’re going to tell me who you brought inside my home.”",
          "ok": true,
          "pos": 11474
