      ],
      "words": 23
    },
    {
      "block": "原句10",
      "no": 10,
      "segments": [
        {
          "text": "\"You're my teenage dream come true,\" I admit with a tiny chuckle",
          "ok": true,
          "pos": 10548
        },
        {
          "text": "\"You've always had all of me, Brooks. All twenty-three and a half years of my life.\"",
