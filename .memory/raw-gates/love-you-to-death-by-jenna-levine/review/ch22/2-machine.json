      "words": 59
    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "“You will say nothing of this to anyone,” I warn with as much dignity as I can muster",
          "ok": true,
          "pos": 2126
        },
        {
