      "no": 1,
      "segments": [
        {
          "text": "My gaze drifts to the heavy leather pack slung over my shoulder, concealing a very small, very illegal dragon",
          "ok": true,
          "pos": 400
        }
      ],
      "words": 19
    },
    {
      "block": "原句2",
      "no": 2,
      "segments": [
        {
          "text": "“Hush, little one. You have to stay out of sight.”",
          "ok": true,
          "pos": 818
        }
      ],
      "words": 10
    },
    {
      "block": "原句3",
      "no": 3,
      "segments": [
        {
          "text": "The last thing we need is for the entire village to discover we’re hiding a fugitive baby dragon",
          "ok": true,
          "pos": 998
        }
      ],
      "words": 18
    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "Her tiny talons click against the hardwood as she scans her new surroundings",
          "ok": true,
          "pos": 1884
        }
      ],
      "words": 13
    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "She pauses midair, her head snapping toward me with an innocent blink",
          "ok": true,
          "pos": 2713
        }
      ],
      "words": 12
    },
    {
      "block": "原句6",
      "no": 6,
      "segments": [
        {
          "text": "“This is where you go potty. Do you understand?”",
          "ok": true,
          "pos": 3468
        }
      ],
      "words": 9
    },
    {
      "block": "原句7",
      "no": 7,
      "segments": [
        {
          "text": "Through the glass, the preparations for tomorrow’s ball are unfolding",
          "ok": true,
          "pos": 3929
        }
      ],
      "words": 10
    },
    {
      "block": "原句8",
      "no": 8,
      "segments": [
        {
          "text": "“Micah,” I say softly. “Will you go to the ball with me?”",
          "ok": true,
          "pos": 4783
        }
      ],
      "words": 12
    },
    {
      "block": "原句9",
      "no": 9,
      "segments": [
        {
          "text": "We can’t let the king ruin this for us",
          "ok": true,
          "pos": 5471
        }
      ],
      "words": 9
    },
    {
      "block": "原句10",
      "no": 10,
      "segments": [
        {
          "text": "“Can I—” He swallows. “Can I stay the night?”",
          "ok": true,
          "pos": 6626
        }
      ],
      "words": 9
    }
