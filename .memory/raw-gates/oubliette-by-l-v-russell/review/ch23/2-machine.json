    {
      "block": "原句11",
      "no": 11,
      "segments": [
        {
          "text": "“Rue Meremoth, you are a terrible friend!” she scolds, leading me into the cottage. Though her words are harsh and true,",
          "ok": true,
          "pos": 4892
