        {
          "text": "We are outside a dilapidated trailer, it's the middle of the night, and I'm sleepy",
          "ok": true,
          "pos": 71
        },
        {
          "text": "\"You gave me bullshit. It didn't feel like anything.\" My mommy throws a plastic bag at his chest",
          "ok": true,
          "pos": 452
        }
      ],
      "words": 34
    },
    {
      "block": "原句2",
      "no": 2,
      "segments": [
        {
          "text": "\"Fuck, fine, get inside. I got some new shit.\" Herb looks left and right, but no one else is outside. Just us",
          "ok": true,
          "pos": 1078
        },
        {
          "text": "\"No, bring her.\" Herb's lips twitch as he takes me in",
          "ok": true,
          "pos": 1223
