    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "One of the hay wagon lights stopped working",
          "ok": true,
          "pos": 5911
        },
        {
          "text": "A vendor needed a longer extension cord",
          "ok": true,
          "pos": 5956
