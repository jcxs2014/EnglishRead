    },
    {
      "block": "原句9",
      "no": 9,
      "segments": [
        {
          "text": "“You miss it.”",
          "ok": true,
          "pos": 16722
        },
        {
          "text": "She didn’t pretend not to understand. “Yes.”",
          "ok": true,
          "pos": 16735
        },
        {
