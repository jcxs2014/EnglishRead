    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "I picked it up. Inside were several strips of faded orange tickets. I hadn’t thought about those in years",
          "ok": true,
          "pos": 5778
        },
        {
          "text": "During the festival, Pops sold cider tickets for fifty cents each, even after Rosie pointed out nobody carried quarters ",
          "ok": true,
