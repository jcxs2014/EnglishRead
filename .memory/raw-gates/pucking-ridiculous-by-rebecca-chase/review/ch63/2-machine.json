    },
    {
      "block": "原句3",
      "no": 3,
      "segments": [
        {
          "text": "\"Nate says they're offering me a two-year contract. I'm waiting on a call to confirm it.\"",
          "ok": true,
          "pos": 1932
        },
        {
          "text": "\"Don't sign it yet. You might get to return home.\"",
          "ok": true,
          "pos": 2018
        }
      ],
      "words": 27
    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "\"Flora is working on something. Trust me, Dad.\" He taps his nose and then laughs so hard that I can't help but join in",
          "ok": true,
          "pos": 2083
        }
      ],
      "words": 24
    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
