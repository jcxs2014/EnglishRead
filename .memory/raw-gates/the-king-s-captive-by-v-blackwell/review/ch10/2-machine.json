        }
      ],
      "words": 40
    },
    {
      "block": "原句9",
      "no": 9,
      "segments": [
        {
          "text": "His voice comes out deeper than usual, almost careful. “Happy birthday, Christopher.”",
          "ok": true,
          "pos": 8826
        },
        {
          "text": "I meet his gaze for the briefest second, then look away and give the tiniest nod",
          "ok": true,
          "pos": 8910
