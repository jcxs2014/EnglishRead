      "words": 51
    },
    {
      "block": "原句6",
      "no": 6,
      "segments": [
        {
          "text": "I don't belong here",
          "ok": true,
          "pos": 3813
        },
        {
          "text": "I was just a college kid. I'm only twenty. Textbooks and late-night coding and quiet evenings in a house that smelled li",
