        }
      ],
      "words": 29
    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "I open the lid of the coffin, then Clay shifts closer and drops Aaron inside",
          "ok": true,
          "pos": 3486
        },
        {
          "text": "I jump down and bring my fist to his face. It stuns him enough that he falls back, and Clay and I close the lid. This is",
