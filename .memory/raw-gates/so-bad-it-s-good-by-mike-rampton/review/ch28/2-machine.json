  "quotes": [
    {
      "block": "原句1",
      "no": 1,
      "segments": [
        {
          "text": "The police station has been broken into and all the toilets stolen. Officers say they have nothing to go on",
          "ok": true,
          "pos": 56
        }
      ],
      "words": 20
    },
    {
      "block": "原句2",
      "no": 2,
      "segments": [
        {
          "text": "All the police cars in the area have had their wheels stolen, so officers will be working tirelessly to find the culprit",
          "ok": true,
          "pos": 165
        }
      ],
      "words": 22
    },
    {
      "block": "原句3",
      "no": 3,
      "segments": [
        {
          "text": "A hole has been found in the fence of a nudist colony. Police say they are looking into it",
          "ok": true,
          "pos": 468
        }
      ],
      "words": 19
    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "Three tons of hair has been stolen from a wig factory. Police are combing the area",
          "ok": true,
          "pos": 560
        }
      ],
      "words": 16
    },
    {
      "block": "原句5",
      "no": 5,
      "segments": [
        {
          "text": "A Tyrannosaurus rex has been arrested for selling guns, and charged with small arms dealing",
          "ok": true,
          "pos": 852
        }
      ],
      "words": 15
    },
    {
      "block": "原句6",
      "no": 6,
      "segments": [
        {
          "text": "A ship carrying red paint and a ship carrying blue paint have collided in the middle of the ocean. Both crews are maroon",
          "ok": true,
          "pos": 1216
        }
      ],
      "words": 23
    },
    {
      "block": "原句7",
      "no": 7,
      "segments": [
        {
          "text": "One lunchtime he stands up and says, ‘Thirty-eight!’ There is stony silence. He sits down mortified at the poor reaction",
          "ok": true,
          "pos": 3229
        }
      ],
      "words": 36
    },
    {
      "block": "原句8",
      "no": 8,
      "segments": [
        {
          "text": "Police hunting a robber who stole a book about Stradivarius have warned the public not to approach him. He has a history",
          "ok": true,
          "pos": 3705
        }
      ],
      "words": 24
    },
    {
      "block": "原句9",
      "no": 9,
      "segments": [
        {
          "text": "What do you say to a dangerous criminal who’s stolen your gate? Nothing. He might take a fence",
          "ok": true,
          "pos": 4021
        }
      ],
      "words": 18
    },
    {
      "block": "原句10",
      "no": 10,
      "segments": [
        {
          "text": "All the police station’s coffee cups have been stolen. They have released some mugshots",
          "ok": true,
          "pos": 4116
        }
      ],
      "words": 14
    }
  ],
