  "facts": [
    {
      "id": "f1",
      "anchor": "It was a luxury Mark had insisted on when we first moved in together.",
      "span_start": 108,
      "span_end": 177,
      "who": "Renata (narrator “I”)",
      "what": "对着电视发呆消磨；电视是同居时马克坚持要买的"
    },
    {
      "id": "f2",
      "anchor": "It was from four nights before he died.",
      "span_start": 2548,
      "span_end": 2587,
      "who": "Mark / Renata",
      "what": "马克住到帕特里克家后给答录机留言；蕾娜塔保留的那条是他死前四晚留的"
    },
    {
      "id": "f3",
      "anchor": "been out with Claude, and when I called back in the morning, no one picked up",
      "span_start": 2604,
      "span_end": 2681,
      "who": "Renata",
      "what": "那晚确实与克劳德外出，早上回电无人接，她选择等他回电"
    },
    {
      "id": "f4",
      "anchor": "Tonight on EVTV, local mystery solved.",
      "span_start": 3120,
      "span_end": 3158,
      "who": "Nikos (EVTV host)",
      "what": "节目开场宣布「本地谜案告破」"
    },
    {
      "id": "f5",
      "anchor": "contain and then remove residual psychic material",
      "span_start": 5644,
      "span_end": 5693,
      "who": "Rick",
      "what": "把 remediation 解释为「先封包再清除残留灵性物质」"
    },
    {
      "id": "f6",
      "anchor": "I am married to my husband forty-nine years.",
      "span_start": 7532,
      "span_end": 7576,
      "who": "Agnes R. of Second Avenue (recorded call)",
      "what": "录音来电播出：结婚四十九年、丈夫过世不到一个月"
    },
    {
      "id": "f7",
      "anchor": "you can’t really think of it as your loved one anymore",
      "span_start": 8380,
      "span_end": 8434,
      "who": "Rick",
      "what": "直视镜头告诉观众（实为蕾娜塔）：残留物不能再当作亲人"
    },
    {
      "id": "f8",
      "anchor": "Fuck you,” I muttered.",
      "span_start": 9129,
      "span_end": 9151,
      "who": "Renata",
      "what": "向着电视低声咒骂（两次）"
    }
  ],
