    },
    {
      "block": "原句4",
      "no": 4,
      "segments": [
        {
          "text": "You're bound to hit me sooner or later, if you just keep shooting. Why not try one more",
          "ok": true,
          "pos": 3588
        },
        {
          "text": "He had been counting. He knew this would be my last bolt",
          "ok": true,
          "pos": 3676
