    {
      "block": "原句3",
      "no": 3,
      "segments": [
        {
          "text": "I fired at his lower paw, producing a yelp of pain. The tray dropped as he stared blankly at me, eyes bulging",
          "ok": true,
          "pos": 2241
        },
        {
