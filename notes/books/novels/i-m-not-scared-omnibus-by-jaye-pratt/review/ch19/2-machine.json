          "pos": 2840
        }
      ],
      "words": 46
    },
    {
      "block": "原句3",
      "no": 3,
      "segments": [
        {
          "text": "Without realizing it, I dressed in clothes he wanted me to wear, but I was so blind to his manipulation",
