# EnglishRead 工作区 .gitignore
# 精读工作区：纯 md + 规则文件，几乎无构建产物

# --- OS 垃圾 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE / 会话状态（各机器/各 IDE 独立）---
# Obsidian vault 配置（插件/布局/偏好，通过 setup_obsidian.sh 从源 vault 链接）
.obsidian/

# Quartz 静态站点（构建产物 + node_modules，保留配置供 CI 构建）
site/node_modules/
site/public/
site/quartz/.quartz-cache/
# Quartz 临时工作区（图标源文件 + 生成 PNG，源文件应在 site/quartz/static/）
site/static/
.memory/
.opencode/
.cortexkit/
.idea/
.vscode/
*.swp
*.swo
*~
.idea/workspace.xml

# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.venvs/
.ElasticBeanstalk/
*.egg-info/
dist/
build/

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- 日志 / 临时 ---
logs/
*.log
*.tmp
*.temp
*.cache
*.bak
*.backup
*.old
*.part
~$*
*.lock

# --- 编辑器 / 工具 ---
.idea/
.vscode/
.cursor/
.windsurf/
.cline/
.aider*

# --- 构建产物 / 生成物 ---
output/
dist/
build/
*.pptx.tmp

# --- Syncthing ---
.stfolder/
.stversions/
.sync-conflict*
*sync-conflict*

# --- 同步工具元数据 ---
sync.ffs_db
*.ffs_lock
*.ffs_tmp
.sync.ffs_db

# --- git 自身 ---
.git/
# --- 本机多 IDE 协作软链（不纳入 git，由模板仓库维护）---
check_collab.sh
setup_multi_ide.sh
sync_memory.sh





# --- Hermes 项目记忆系统（本地缓存，不纳入 git）---
HERMES_MEMORY/

# --- 原文源文件（只跟踪精读 _精读.md，原文 .src.md 忽略）---
*.src.md

# --- 小说原始 epub 与提取文本（只跟踪精读笔记，原文件忽略）---
notes/novels/**/library/
notes/novels/**/text/
notes/novels/**/_chapters.json
notes/novels/tags              # calibre ebook-meta 自动产生的封面缓存
